@host = http://localhost:5194

### Get all workouts
GET {{host}}/workouts

### Personal records
GET {{host}}/workouts/records

### Create a workout with sets
POST {{host}}/workouts
Content-Type: application/json

{
  "notes": "Chest and legs day",
  "sets": [
    { "exercise": "Bench press", "reps": 10, "weightKg": 60 },
    { "exercise": "Bench press", "reps": 8, "weightKg": 70 },
    { "exercise": "Squat", "reps": 8, "weightKg": 80 }
  ]
}

### Invalid: empty exercise and negative reps (expect 400)
POST {{host}}/workouts
Content-Type: application/json

{
  "sets": [
    { "exercise": "", "reps": -5, "weightKg": 60 }
  ]
}

### Invalid: no sets and a future date (expect 400)
POST {{host}}/workouts
Content-Type: application/json

{
  "date": "2099-01-01",
  "sets": []
}

### Get a single workout
GET {{host}}/workouts/1

### Delete a workout
DELETE {{host}}/workouts/1